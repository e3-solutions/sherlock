{
  "schema_version": 1,
  "id": "sherlock",
  "version": "0.1.0",
  "owner": "e3-solutions",
  "providers": ["codex", "claude"],
  "include": [
    "packages/telemetry-collector/src",
    "plugins/sherlock/scripts/run_hook.py",
    "plugins/sherlock/scripts/collective_feedback.py",
    "plugins/sherlock-claude-code/scripts/run_hook.py",
    "plugins/sherlock-claude-code/scripts/collective_feedback.py"
  ],
  "environment": {"SHERLOCK_COLLECTOR_SOURCE": {"component_path": "packages/telemetry-collector/src"}},
  "hook_defaults": {
    "providers": ["claude"],
    "timeout_seconds": 2,
    "background_work": {
      "mode": "existing-worker",
      "purpose": "Existing detached capture and queue drain, including terminal transcript settling; lifecycle remains unready, centrally reject selected worker hooks."
    }
  },
  "hooks": [
    {
      "id": "codex-session-start",
      "event": "SessionStart",
      "providers": ["codex"],
      "entrypoint": "plugins/sherlock/scripts/run_hook.py",
      "invocation": {"kind": "python-script", "args": ["SessionStart"], "output": "codex-json"},
      "timeout_seconds": 30,
      "background_work": {
        "mode": "existing-worker",
        "purpose": "Existing detached queue drain after foreground capture; lifecycle remains unready, centrally reject selected worker hooks."
      }
    },
    {
      "id": "codex-user-prompt-submit",
      "event": "UserPromptSubmit",
      "providers": ["codex"],
      "entrypoint": "plugins/sherlock/scripts/run_hook.py",
      "invocation": {"kind": "python-script", "args": ["UserPromptSubmit"], "output": "codex-json"},
      "timeout_seconds": 30,
      "background_work": {
        "mode": "existing-worker",
        "purpose": "Existing detached queue drain after foreground capture; lifecycle remains unready, centrally reject selected worker hooks."
      }
    },
    {
      "id": "codex-post-tool-use",
      "event": "PostToolUse",
      "providers": ["codex"],
      "entrypoint": "plugins/sherlock/scripts/run_hook.py",
      "invocation": {"kind": "python-script", "args": ["PostToolUse"], "output": "codex-json"},
      "timeout_seconds": 30,
      "background_work": {
        "mode": "existing-worker",
        "purpose": "Existing detached queue drain after foreground capture; lifecycle remains unready, centrally reject selected worker hooks."
      }
    },
    {
      "id": "codex-post-compact",
      "event": "PostCompact",
      "providers": ["codex"],
      "entrypoint": "plugins/sherlock/scripts/run_hook.py",
      "invocation": {"kind": "python-script", "args": ["PostCompact"], "output": "codex-json"},
      "timeout_seconds": 30,
      "background_work": {
        "mode": "existing-worker",
        "purpose": "Existing detached queue drain after foreground capture; lifecycle remains unready, centrally reject selected worker hooks."
      }
    },
    {
      "id": "codex-subagent-start",
      "event": "SubagentStart",
      "providers": ["codex"],
      "entrypoint": "plugins/sherlock/scripts/run_hook.py",
      "invocation": {"kind": "python-script", "args": ["SubagentStart"], "output": "codex-json"},
      "timeout_seconds": 30,
      "background_work": {
        "mode": "existing-worker",
        "purpose": "Existing detached queue drain after foreground capture; lifecycle remains unready, centrally reject selected worker hooks."
      }
    },
    {
      "id": "codex-subagent-stop",
      "event": "SubagentStop",
      "providers": ["codex"],
      "entrypoint": "plugins/sherlock/scripts/run_hook.py",
      "invocation": {"kind": "python-script", "args": ["SubagentStop"], "output": "codex-json"},
      "timeout_seconds": 30,
      "background_work": {
        "mode": "existing-worker",
        "purpose": "Existing detached queue drain after foreground capture; lifecycle remains unready, centrally reject selected worker hooks."
      }
    },
    {
      "id": "codex-stop",
      "event": "Stop",
      "providers": ["codex"],
      "entrypoint": "plugins/sherlock/scripts/run_hook.py",
      "invocation": {"kind": "python-script", "args": ["Stop"], "output": "codex-json"},
      "timeout_seconds": 30,
      "background_work": {
        "mode": "existing-worker",
        "purpose": "Existing detached queue drain after foreground capture; lifecycle remains unready, centrally reject selected worker hooks."
      }
    },
    {
      "id": "claude-session-start",
      "event": "SessionStart",
      "entrypoint": "plugins/sherlock-claude-code/scripts/run_hook.py",
      "invocation": {"kind": "python-script", "args": ["SessionStart"], "output": "context"}
    },
    {
      "id": "claude-user-prompt-submit",
      "event": "UserPromptSubmit",
      "entrypoint": "plugins/sherlock-claude-code/scripts/run_hook.py",
      "invocation": {"kind": "python-script", "args": ["UserPromptSubmit"], "output": "ignore"}
    },
    {
      "id": "claude-post-tool-use",
      "event": "PostToolUse",
      "entrypoint": "plugins/sherlock-claude-code/scripts/run_hook.py",
      "invocation": {"kind": "python-script", "args": ["PostToolUse"], "output": "ignore"}
    },
    {
      "id": "claude-stop",
      "event": "Stop",
      "entrypoint": "plugins/sherlock-claude-code/scripts/run_hook.py",
      "invocation": {"kind": "python-script", "args": ["Stop"], "output": "ignore"}
    },
    {
      "id": "claude-subagent-start",
      "event": "SubagentStart",
      "entrypoint": "plugins/sherlock-claude-code/scripts/run_hook.py",
      "invocation": {"kind": "python-script", "args": ["SubagentStart"], "output": "ignore"}
    },
    {
      "id": "claude-subagent-stop",
      "event": "SubagentStop",
      "entrypoint": "plugins/sherlock-claude-code/scripts/run_hook.py",
      "invocation": {"kind": "python-script", "args": ["SubagentStop"], "output": "ignore"}
    },
    {
      "id": "claude-session-end",
      "event": "SessionEnd",
      "entrypoint": "plugins/sherlock-claude-code/scripts/run_hook.py",
      "invocation": {"kind": "python-script", "args": ["SessionEnd"], "output": "ignore"}
    }
  ],
  "dependencies": [{"kind": "executable", "name": "git"}],
  "state": [
    {
      "id": "codex-telemetry",
      "purpose": "Exact retained CODEX_HOME/sherlock/telemetry; native launcher cannot consume arbitrary mapped roots.",
      "rollback_compatible": true
    },
    {
      "id": "claude-telemetry",
      "purpose": "Exact retained CLAUDE_CONFIG_DIR/sherlock/telemetry; native launcher hardcodes this root.",
      "rollback_compatible": true
    },
    {
      "id": "forum-feedback",
      "purpose": "Existing E3_COLLECTIVE_HOOK_STATE_DIR or HOME/.cache/e3-collective; shared Forum cue state requires central ownership review.",
      "rollback_compatible": true
    }
  ]
}
