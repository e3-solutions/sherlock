# Secret allowlist. Store token hashes, not plaintext collector bearer tokens.
SHERLOCK_COLLECTORS_JSON=[{"token_sha256":"<lowercase-sha256>","workspace_id":"<uuid>","person_id":"<uuid>","collector_key":"<path-safe-key>"}]

# SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, and SUPABASE_DB_URL are provided to
# deployed Edge Functions. The Supabase CLI supplies local equivalents.
