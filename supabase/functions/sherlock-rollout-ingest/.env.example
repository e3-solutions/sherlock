# Shared team credential allowlist. Store token hashes, not plaintext bearer tokens.
# collector_key is a path-safe namespace; the function adds a per-machine digest.
SHERLOCK_COLLECTORS_JSON=[{"token_sha256":"<lowercase-sha256>","workspace_id":"<uuid>","collector_key":"team"}]

# SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, and SUPABASE_DB_URL are provided to
# deployed Edge Functions. The Supabase CLI supplies local equivalents.
