# Public ingest is scoped to this workspace. The function derives a distinct
# collector key for each declared email and installation UUID.
SHERLOCK_E3_WORKSPACE_ID=<uuid>
SHERLOCK_SIXTYFOUR_WORKSPACE_ID=<uuid>

# SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, and SUPABASE_DB_URL are provided to
# deployed Edge Functions. Use a hosted pooler URL: session-pooler URLs on port
# 5432 are routed to transaction mode on port 6543 in code and limited to one
# client per isolate; hosted direct URLs fail closed. The Supabase CLI supplies
# local equivalents.
