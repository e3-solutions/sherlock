# Public ingest is scoped to this workspace. The function derives a distinct
# collector key for each declared email and installation UUID.
SHERLOCK_E3_WORKSPACE_ID=<uuid>
SHERLOCK_SIXTYFOUR_WORKSPACE_ID=<uuid>

# Set this custom secret BEFORE deploying sherlock-rollout-ingest. Supabase's
# injected SUPABASE_DB_URL is a direct connection and is intentionally ignored.
# Copy the transaction-pooler URL from the project's Connect dialog, preserving
# its pooler username and credentials. Never commit the real value.
SHERLOCK_INGEST_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided to deployed Edge
# Functions. Session-pooler URLs on port 5432 are routed to transaction mode on
# port 6543 in code, with one client per isolate. Hosted direct URLs fail closed.
# For local CLI development, set SHERLOCK_INGEST_DATABASE_URL to the local
# Postgres URL explicitly.
#
# After deployment, submit a valid collector batch and verify its matching
# committed receipt. Confirm queued collector retries drain and those sessions
# appear on the dashboard after processing. Preserve collector state and queued
# uploads so the existing retries can backfill; do not reset or reinstall.
