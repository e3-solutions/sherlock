  },
  "railway": {
    "project_id": "<read-back-id>",
    "project_name": "<exact-payload-name>",
    "environment_id": "<read-back-production-id>",
    "environment_name": "<exact-payload-name>",
    "dashboard_service_id": "<read-back-id>",
    "dashboard_service_name": "<exact-payload-name>",
    "worker_service_id": "<read-back-id>",
    "worker_service_name": "<exact-payload-name>",
    "direct_slack_enabled": false
  },
  "verification": {
    "offline_bundle": "<passed>",
    "template_cases": [
      "firing",
      "resolved",
      "mixed",
      "empty",
      "missing-severity",
      "missing-description"
    ],
    "constant_rule_firing_and_recovery": "<passed|not-applied>",
    "synthetic_firing_and_recovery": "<passed|not-applied>",
    "supabase_query_preview": "<passed|not-applied>",
    "grafana_rule_fields_match_contract": "<passed|not-applied>",
    "synthetic_check_fields_match_contract": "<passed|not-applied>",
    "notification_route_fields_match_contract": "<passed|not-applied>",
    "template_fields_match_contract": "<passed|not-applied>",
    "railway_delivery_contract": "<passed|not_applied_gate_closed>"
