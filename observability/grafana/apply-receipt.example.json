{
  "schema_version": 1,
  "source_commit": "<40-character-git-sha>",
  "operator": "<human-name>",
  "applied_at": "<ISO-8601-UTC>",
  "change_ticket": "<issue-or-change-url>",
  "desired_state_fingerprints": {
    "bundle": "sha256:<hex>",
    "rules": "sha256:<hex>",
    "synthetics": "sha256:<hex>",
    "routing": "sha256:<hex>",
    "template": "sha256:<hex>",
    "railway": "sha256:<hex>"
  },
  "grafana": {
    "stack": "e3capital.grafana.net",
    "version": "<read-back-version>",
    "synthetic_monitoring_version": "<read-back-version>",
    "prometheus_datasource_uid": "<read-back-uid>",
    "folder_uid": "bonaparte",
    "rule_group": "bonaparte-production",
    "default_receiver_before": "<read-back-name>",
    "default_receiver_after": "<same-name>",
    "rule_uids": [
      "bonaparte-dashboard-unavailable",
      "bonaparte-pipeline-freshness",
      "bonaparte-synthetic-telemetry-missing",
      "bonaparte-supabase-telemetry-missing",
      "bonaparte-supabase-pool-waiting"
    ],
    "contact_point": "Bonaparte Production Slack",
    "unrelated_policy_export_before": "<private-backup-reference>",
    "unrelated_policy_export_after": "<private-read-back-reference>",
    "unrelated_policy_routes_unchanged": "<passed|failed>"
  },
  "synthetics": {
