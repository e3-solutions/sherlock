{
  "name": "@sherlock/dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "vite build --config frontend/vite.config.js",
    "check": "node --check server.mjs && node --check src/server/flame-source.js",
    "dev": "concurrently -k \"node --watch server.mjs\" \"vite --config frontend/vite.config.js\"",
    "start": "node server.mjs",
    "test": "vitest run --config frontend/vitest.config.js",
    "test:watch": "vitest --config frontend/vitest.config.js"
  },
  "dependencies": {
    "@fontsource/geist-sans": "5.3.0",
    "postgres": "3.4.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@vitejs/plugin-react": "6.0.5",
    "concurrently": "9.2.1",
    "jsdom": "30.0.1",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
