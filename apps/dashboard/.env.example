# Shared Supavisor transaction mode for dashboards; keep the worker's separate
# session-mode URL unchanged. Local/direct PostgreSQL URLs are also supported.
SUPABASE_DB_URL=postgresql://sherlock_worker_login.project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres
SHERLOCK_WORKSPACE_ID=00000000-0000-4000-8000-000000000000
SHERLOCK_DASHBOARD_EMAIL_DOMAIN=e3group.ai
SHERLOCK_DASHBOARD_MAX_PEOPLE=500
# At least 32 characters. Keep this server-side and give MCP clients only the
# bearer value, never SUPABASE_DB_URL.
SHERLOCK_MCP_TOKEN=replace-with-a-long-random-secret
PORT=8000
