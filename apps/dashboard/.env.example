SUPABASE_DB_URL=postgresql://sherlock_worker_login:password@host:5432/postgres
SHERLOCK_WORKSPACE_ID=00000000-0000-4000-8000-000000000000
SHERLOCK_DASHBOARD_EMAIL_DOMAIN=e3group.ai
SHERLOCK_DASHBOARD_MAX_PEOPLE=500
# Inject at deployment from a secret manager; at least 32 characters. Never
# bundle the bearer or expose SUPABASE_DB_URL to clients.
SHERLOCK_MCP_TOKEN=
# Keep false until a durable external write throttle is in place.
SHERLOCK_MCP_CANDIDATE_WRITES_ENABLED=false
PORT=8000
