{
  "schema_version": 1,
  "id": "sherlock",
  "version": "0.1.0-jr-preparation",
  "owner": "e3-solutions",
  "providers": [
    "codex",
    "claude"
  ],
  "runtime": {
    "python_min": "3.11"
  },
  "include": [
    "integrations/jolly-roger/hook.py",
    "packages/telemetry-collector/src/sherlock_collector",
    "plugins/sherlock-claude-code/scripts/run_hook.py"
  ],
  "hooks": [
