      "id": "session-start",
      "event": "SessionStart",
      "providers": [
        "codex",
        "claude"
      ],
      "entrypoint": "integrations/jolly-roger/hook.py",
      "timeout_seconds": 30,
      "failure_policy": "continue",
      "background_work": {
        "mode": "existing-worker",
        "purpose": "Preserve existing detached capture (Claude) and queue drains (both providers); activation blocked pending central worker ownership proof."
      }
    },
