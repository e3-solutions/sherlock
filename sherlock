#!/bin/sh

set -eu

REPO_ROOT=$(CDPATH= cd "$(dirname "$0")" && pwd)
PYTHON_BIN=${PYTHON_BIN:-python3}
SHERLOCK_HOME=${SHERLOCK_HOME:-"$HOME/.sherlock"}
CODEX_HOME=${CODEX_HOME:-"$HOME/.codex"}
CLAUDE_CONFIG_DIR=${CLAUDE_CONFIG_DIR:-"$HOME/.claude"}
NAME=""
GITHUB_ID=""
EMAIL=""
CLAUDE_BACKFILL_HOURS=72

usage() {
  cat <<'EOF'
Usage: ./sherlock install --name NAME --github LOGIN --email EMAIL [--claude-backfill-hours HOURS]

Installs Sherlock for each available Codex or Claude Code CLI with the same
team identity. At least one usable agent CLI must already be installed.

Aliases:
  --github-id LOGIN     Same as --github

Environment overrides:
  CODEX_BIN             Codex executable to use
  CODEX_HOME            Codex state directory (default: ~/.codex)
  CLAUDE_BIN            Claude executable to use
  CLAUDE_CONFIG_DIR     Claude state directory (default: ~/.claude)
  SHERLOCK_HOME         Durable client marketplace (default: ~/.sherlock)
  PYTHON_BIN            Python 3 executable (default: python3)
  SHERLOCK_INGEST_URL   Collector endpoint

Options:
  --claude-backfill-hours  Initial Claude transcript lookback (default: 72; max: 744)
EOF
}

if [ "$#" -eq 0 ]; then
  usage >&2
  exit 2
fi

case "$1" in
  install)
    shift
    ;;
  -h|--help|help)
    usage
    exit 0
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac

while [ "$#" -gt 0 ]; do
  case "$1" in
    --name)
      [ "$#" -ge 2 ] || { usage >&2; exit 2; }
      NAME=$2
      shift 2
      ;;
    --github|--github-id|--github_id)
      [ "$#" -ge 2 ] || { usage >&2; exit 2; }
      GITHUB_ID=$2
      shift 2
      ;;
    --email)
      [ "$#" -ge 2 ] || { usage >&2; exit 2; }
      EMAIL=$2
      shift 2
      ;;
    --claude-backfill-hours)
      [ "$#" -ge 2 ] || { usage >&2; exit 2; }
      CLAUDE_BACKFILL_HOURS=$2
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
done

if [ -z "$NAME" ] || [ -z "$GITHUB_ID" ] || [ -z "$EMAIL" ]; then
  usage >&2
  exit 2
fi

case "$CLAUDE_BACKFILL_HOURS" in
  ''|*[!0-9]*)
    echo "--claude-backfill-hours must be an integer from 1 to 744." >&2
    exit 2
    ;;
esac
if [ "$CLAUDE_BACKFILL_HOURS" -lt 1 ] || [ "$CLAUDE_BACKFILL_HOURS" -gt 744 ]; then
  echo "--claude-backfill-hours must be an integer from 1 to 744." >&2
  exit 2
fi

if ! command -v "$PYTHON_BIN" >/dev/null 2>&1; then
  echo "Python 3 is required." >&2
  exit 1
fi

# Resolve both agent CLIs before either provider installer changes local state.
RESOLVED_CODEX_BIN=""
CODEX_SKIP_REASON="not found"
if [ -n "${CODEX_BIN:-}" ]; then
  if [ ! -x "$CODEX_BIN" ]; then
    CODEX_SKIP_REASON="configured CODEX_BIN is not executable"
  elif ! "$CODEX_BIN" --version >/dev/null 2>&1; then
    CODEX_SKIP_REASON="configured Codex CLI is not usable"
  else
    RESOLVED_CODEX_BIN=$CODEX_BIN
  fi
else
  if command -v codex >/dev/null 2>&1; then
    CANDIDATE=$(command -v codex)
    if "$CANDIDATE" --version >/dev/null 2>&1; then
      RESOLVED_CODEX_BIN=$CANDIDATE
    else
      CODEX_SKIP_REASON="found Codex CLI is not usable"
    fi
  fi
  if [ -z "$RESOLVED_CODEX_BIN" ] && [ -x /Applications/ChatGPT.app/Contents/Resources/codex ]; then
    if /Applications/ChatGPT.app/Contents/Resources/codex --version >/dev/null 2>&1; then
      RESOLVED_CODEX_BIN=/Applications/ChatGPT.app/Contents/Resources/codex
    else
      CODEX_SKIP_REASON="Codex desktop CLI is not usable"
    fi
  fi
fi

RESOLVED_CLAUDE_BIN=""
CLAUDE_SKIP_REASON="not found"
if [ -n "${CLAUDE_BIN:-}" ]; then
  if [ ! -x "$CLAUDE_BIN" ]; then
    CLAUDE_SKIP_REASON="configured CLAUDE_BIN is not executable"
  elif ! "$CLAUDE_BIN" --version >/dev/null 2>&1; then
    CLAUDE_SKIP_REASON="configured Claude Code CLI is not usable"
  else
    RESOLVED_CLAUDE_BIN=$CLAUDE_BIN
  fi
else
  if command -v claude >/dev/null 2>&1; then
    CANDIDATE=$(command -v claude)
    if "$CANDIDATE" --version >/dev/null 2>&1; then
      RESOLVED_CLAUDE_BIN=$CANDIDATE
    else
      CLAUDE_SKIP_REASON="found Claude Code CLI is not usable"
    fi
  fi
fi

if [ -z "$RESOLVED_CODEX_BIN" ] && [ -z "$RESOLVED_CLAUDE_BIN" ]; then
  echo "No usable Codex or Claude Code CLI was found; nothing was installed." >&2
  echo "  Codex: skipped - $CODEX_SKIP_REASON" >&2
  echo "  Claude Code: skipped - $CLAUDE_SKIP_REASON" >&2
  exit 1
fi

if [ -n "$RESOLVED_CODEX_BIN" ]; then
  "$PYTHON_BIN" "$REPO_ROOT/plugins/sherlock/scripts/validate_install_email.py" \
    --email "$EMAIL" \
    --collector-home "$CODEX_HOME"
fi
if [ -n "$RESOLVED_CLAUDE_BIN" ]; then
  "$PYTHON_BIN" "$REPO_ROOT/plugins/sherlock/scripts/validate_install_email.py" \
    --email "$EMAIL" \
    --collector-home "$CLAUDE_CONFIG_DIR"
fi

MARKETPLACE_ROOT="$SHERLOCK_HOME/marketplace"
"$PYTHON_BIN" "$REPO_ROOT/plugins/sherlock/scripts/stage_marketplace.py" \
  --repo-root "$REPO_ROOT" \
  --destination "$MARKETPLACE_ROOT"

if [ -n "$RESOLVED_CODEX_BIN" ]; then
  SHERLOCK_MARKETPLACE_ROOT=$MARKETPLACE_ROOT \
    CODEX_BIN=$RESOLVED_CODEX_BIN "$REPO_ROOT/install.sh" \
    --name "$NAME" \
    --github-id "$GITHUB_ID" \
    --email "$EMAIL"
fi

if [ -n "$RESOLVED_CLAUDE_BIN" ]; then
  SHERLOCK_MARKETPLACE_ROOT=$MARKETPLACE_ROOT \
    CLAUDE_BIN=$RESOLVED_CLAUDE_BIN "$REPO_ROOT/install-claude.sh" \
    --name "$NAME" \
    --github-id "$GITHUB_ID" \
    --email "$EMAIL" \
    --backfill-hours "$CLAUDE_BACKFILL_HOURS"
fi

echo "Sherlock installation summary:"
if [ -n "$RESOLVED_CODEX_BIN" ]; then
  echo "  Codex: installed"
else
  echo "  Codex: skipped - $CODEX_SKIP_REASON"
fi
if [ -n "$RESOLVED_CLAUDE_BIN" ]; then
  echo "  Claude Code: installed"
else
  echo "  Claude Code: skipped - $CLAUDE_SKIP_REASON"
fi
echo "Start a new session in each installed agent to load its hooks."
